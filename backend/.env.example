# Backend Environment Variables
# Copy to .env and fill in values

# Server
SERVER_PORT=8080
ENVIRONMENT=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=better
DB_PASSWORD=your_secure_password_here
DB_NAME=better
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your_access_secret_key_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# APIs
ODDS_API_KEY=your_odds_api_key_here
ABACUS_API_KEY=your_abacus_api_key_here
ABACUS_API_URL=https://api.abacus.ai/v1
NBA_STATS_URL=https://stats.nba.com/stats

# Rate Limiting
RATE_LIMIT_IP=100
RATE_LIMIT_USER=1000

# Scraper Schedule
SCRAPER_DAILY_SCHEDULE=0 6 * * *
SCRAPER_RESULT_SCHEDULE=0 8 * * *
